{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "indomahjong-server",
  "main": "index.ts",
  // api.maciokyu.com for new clients; workers.dev stays on so older builds keep working during the move.
  "routes": [{ "pattern": "api.maciokyu.com", "custom_domain": true }],
  "workers_dev": true,
  "compatibility_date": "2026-11-15",
  "d1_databases": [{ "binding": "DB", "database_name": "maciokyu", "database_id": "1cd9ef17-69b2-4bf3-be0d-51b9775a7f0f", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }] },
  "vars": { "LOGIN_REQUIRED": "true", "FACEBOOK_ENABLED": "false" },
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },{ "name": "ROOM_CREATION_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
