{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "indomahjong-server",
  "main": "index.ts",
  // api.maciokyu.com for new clients; workers.dev stays on so older builds keep working during the move.
  "routes": [{ "pattern": "api.maciokyu.com", "custom_domain": true }],
  "workers_dev": true,
  "compatibility_date": "2026-11-15",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }] },
  "ratelimits": [{ "name": "ROOM_CREATION_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
